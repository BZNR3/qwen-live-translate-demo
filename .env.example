# Required: create these in Alibaba Cloud Model Studio.
DASHSCOPE_API_KEY=sk-your-key
QWEN_WORKSPACE_ID=your-workspace-id

# singapore or beijing. The API key and workspace must belong to this region.
QWEN_REGION=singapore

# Optional overrides.
QWEN_MODEL=qwen3.5-livetranslate-flash-realtime
LOCAL_TRANSLATOR_URL=http://127.0.0.1:8765
# LOCAL_ASR_MODEL=mlx-community/whisper-small-mlx
# LOCAL_QWEN_MODEL=Qwen/Qwen3-1.7B-MLX-4bit
PORT=8787
HOST=127.0.0.1

# Advanced: use a complete endpoint instead of QWEN_WORKSPACE_ID/QWEN_REGION.
# QWEN_REALTIME_URL=wss://your-workspace.ap-southeast-1.maas.aliyuncs.com/api-ws/v1/realtime
